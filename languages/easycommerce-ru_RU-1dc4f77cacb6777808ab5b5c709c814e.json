            ],
            "Chat to run your store: ask about sales, create and edit products, and update orders - in plain English, with your approval.": [
                "\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u043c\u0430\u0433\u0430\u0437\u0438\u043d\u043e\u043c \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0442: \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0439\u0442\u0435 \u043e \u043f\u0440\u043e\u0434\u0430\u0436\u0430\u0445, \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0438 \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u0443\u0439\u0442\u0435 \u0442\u043e\u0432\u0430\u0440\u044b, \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0439\u0442\u0435 \u0437\u0430\u043a\u0430\u0437\u044b \u2014 \u043e\u0431\u044b\u0447\u043d\u044b\u043c \u044f\u0437\u044b\u043a\u043e\u043c \u0438 \u0441 \u0432\u0430\u0448\u0435\u0433\u043e \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u044f."
            ],
            "Shopping Agent - For Your Shoppers": [
                "\u0410\u0433\u0435\u043d\u0442 \u043f\u043e\u043a\u0443\u043f\u043e\u043a \u2014 \u0434\u043b\u044f \u0432\u0430\u0448\u0438\u0445 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u0435\u0439"
            ],
            "A 24\/7 storefront agent that helps customers find the right product, answers their questions, and places orders for them.": [
                "\u041a\u0440\u0443\u0433\u043b\u043e\u0441\u0443\u0442\u043e\u0447\u043d\u044b\u0439 \u0430\u0433\u0435\u043d\u0442 \u0432\u0438\u0442\u0440\u0438\u043d\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u043a\u043b\u0438\u0435\u043d\u0442\u0430\u043c \u043d\u0430\u0439\u0442\u0438 \u043d\u0443\u0436\u043d\u044b\u0439 \u0442\u043e\u0432\u0430\u0440, \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u043d\u0430 \u0432\u043e\u043f\u0440\u043e\u0441\u044b \u0438 \u043e\u0444\u043e\u0440\u043c\u043b\u044f\u0435\u0442 \u0437\u0430\u043a\u0430\u0437\u044b \u0437\u0430 \u043d\u0438\u0445."
            ],
            "Plus": [
                "\u041f\u043b\u044e\u0441"
            ],
            "& more.": [
                "\u0438 \u0434\u0440\u0443\u0433\u043e\u0435."
            ],
            "Each AI request transmits only the relevant records - the item you're working on, or a shopper's query and its products - to EasyCommerce's AI service. Your bulk customer and order data is never uploaded, sold, or used to train models.": [
                "\u041a\u0430\u0436\u0434\u044b\u0439 \u0437\u0430\u043f\u0440\u043e\u0441 \u043a \u0418\u0418 \u043f\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0435\u043b\u0435\u0432\u0430\u043d\u0442\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u2014 \u0442\u043e\u0432\u0430\u0440, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0432\u044b \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442\u0435, \u0438\u043b\u0438 \u0437\u0430\u043f\u0440\u043e\u0441 \u043f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044f \u0438 \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0435 \u0441 \u043d\u0438\u043c \u0442\u043e\u0432\u0430\u0440\u044b \u2014 \u0441\u0435\u0440\u0432\u0438\u0441\u0443 \u0418\u0418 EasyCommerce. \u0412\u0430\u0448\u0438 \u043c\u0430\u0441\u0441\u0438\u0432\u044b \u0434\u0430\u043d\u043d\u044b\u0445 \u043e \u043a\u043b\u0438\u0435\u043d\u0442\u0430\u0445 \u0438 \u0437\u0430\u043a\u0430\u0437\u0430\u0445 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u044e\u0442\u0441\u044f, \u043d\u0435 \u043f\u0440\u043e\u0434\u0430\u044e\u0442\u0441\u044f \u0438 \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u0434\u043b\u044f \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u043c\u043e\u0434\u0435\u043b\u0435\u0439."
            ],
