            "The link in your email connects AI automatically. To do it manually, paste the key we emailed below.": [
                "\u0421\u0441\u044b\u043b\u043a\u0430 \u0432 \u043f\u0438\u0441\u044c\u043c\u0435 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u0418\u0418 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438. \u0427\u0442\u043e\u0431\u044b \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u044d\u0442\u043e \u0432\u0440\u0443\u0447\u043d\u0443\u044e, \u0432\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043d\u0438\u0436\u0435 \u043a\u043b\u044e\u0447, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u044b \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u043b\u0438 \u043f\u043e \u044d\u043b. \u043f\u043e\u0447\u0442\u0435."
