            ],
            "Example: Make it 2 columns with a big gallery section at left.": [
                "\u041f\u0440\u0438\u043c\u0435\u0440: \u0441\u0434\u0435\u043b\u0430\u0439 \u0432 2 \u0441\u0442\u043e\u043b\u0431\u0446\u0430 \u0441 \u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0433\u0430\u043b\u0435\u0440\u0435\u0435\u0439 \u0441\u043b\u0435\u0432\u0430."
            ],
