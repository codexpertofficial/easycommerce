<?xml version="1.0"?>
<ruleset name="EasyCommerce">
	<description>EasyCommerce WordPress Plugin Coding Standards</description>

	<!-- Scan app/ by default -->
	<file>app/</file>

	<!-- Show sniff codes in reports -->
	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<!-- PHP version compatibility target -->
	<config name="testVersion" value="7.4-"/>

	<!-- Plugin text domain -->
	<config name="text_domain" value="easycommerce"/>

	<!-- Minimum supported WordPress version -->
	<config name="minimum_wp_version" value="6.0"/>

	<!-- Base standard -->
	<rule ref="WordPress">
		<!--
			PSR-4 autoloading requires PascalCase filenames (e.g. Cart.php, Order.php).
			WordPress coding standards expect hyphenated-lowercase (class-cart.php).
			Exclude filename rules so PSR-4 layout is not flagged.
		-->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<!-- Generated / third-party directories -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<!-- Frontend source — linted by ESLint, not PHPCS -->
	<exclude-pattern>*/spa/*</exclude-pattern>
	<exclude-pattern>*/blocks/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>

	<!-- Release / CI artifacts -->
	<exclude-pattern>*/release/*</exclude-pattern>
	<exclude-pattern>*/svn-assets/*</exclude-pattern>

	<!-- Test suite has its own style rules -->
	<exclude-pattern>*/tests/*</exclude-pattern>
</ruleset>
