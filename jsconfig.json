{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"jsx": "react-jsx",
		"moduleResolution": "node",
		"baseUrl": ".",
		"paths": {
			"@/*": ["spa/admin/easycommerce/*"],
			"@components/*": ["spa/admin/easycommerce/components/*"],
			"@lib/*": ["spa/admin/easycommerce/lib/*"],
			"@pages/*": ["spa/admin/easycommerce/pages/*"],
			"@hooks/*": ["spa/admin/easycommerce/hooks/*"]
		},
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true
	},
	"include": [
		"spa/**/*",
		"assets/**/*"
	],
	"exclude": [
		"node_modules",
		"build",
		"vendor"
	]
}