{
    "name": "easycommerce/easycommerce",
    "description": "Ecommerce with WordPress made easy.",
    "license": "GPL-2.0-or-later",
    "type": "wordpress-plugin",
    "version": "dev-develop",
    "scripts": {
        "test": "phpunit",
        "test-f": "phpunit --filter",
        "test-reports": "phpunit --testsuite Reports",
        "makepot": "wp i18n make-pot . languages/easycommerce.pot --slug=easycommerce --exclude=node_modules,vendor,docs,svn-assets,release,samples,tests --allow-root",
        "release": [
            "rm -rf release vendor build/*",
            "yarn build",
            "@makepot",
            "wp i18n make-mo languages/ languages/ --allow-root",
            "wp i18n make-json languages/ --pretty-print --allow-root",
            "mkdir -p release",
            "composer install --no-dev --optimize-autoloader",
            "rsync -av --exclude-from=.distignore . release/easycommerce/",
            "cd release && zip -r easycommerce.zip easycommerce/",
            "rm -rf release/easycommerce/"
        ]
    },
    "autoload": {
        "psr-4": {
            "EasyCommerce\\": "app/"
        },
        "files": [
          "app/Helpers/functions.php",
          "app/Controllers/Payment/Stripe/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "EasyCommerce\\Tests\\": "tests/php/src/"
        }
    },
    "authors": [
        {
            "name": "EasyCommerce"
        }
    ],
    "require": {
        "php": ">=7.4",
        "stripe/stripe-php": "^18.2",
        "mollie/mollie-api-php": "^3.6",
        "braintree/braintree_php": "~6.32.0",
        "square/square": "26.0.0.20230419"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^6.6",
        "yoast/phpunit-polyfills": "^1.0",
        "brain/monkey": "^2.6",
        "squizlabs/php_codesniffer": "^3.7",
        "phpcompatibility/php-compatibility": "^9.3",
        "wp-coding-standards/wpcs": "^3.0",
        "mockery/mockery": "^1.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "7.4"
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
